{
  "name": "nocap",
  "version": "0.2.0",
  "description": "Prevent screenshots of text on the web. Anti-screenshot, anti-AI-scraper display: frames alternate at refresh rate so your eye reads the secret and a single screen capture gets noise \u2014 and the text never enters the DOM.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./secret": "./src/secret.js",
    "./splitter": "./src/splitter.js",
    "./palette": "./src/palette.js",
    "./fake": "./src/fake.js"
  },
  "sideEffects": [
    "./src/secret.js"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "demo": "npx --yes serve . --listen tcp://127.0.0.1:8787"
  },
  "keywords": [
    "prevent-screenshot",
    "anti-screenshot",
    "screenshot-protection",
    "screenshot-proof",
    "screen-capture",
    "prevent-screen-capture",
    "anti-scraping",
    "anti-ai-scraper",
    "hide-text-from-ai",
    "secret",
    "privacy",
    "security",
    "watermark",
    "flicker",
    "persistence-of-vision",
    "canvas",
    "web-component",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acieshk/nocap.git"
  },
  "bugs": {
    "url": "https://github.com/acieshk/nocap/issues"
  },
  "homepage": "https://github.com/acieshk/nocap#readme",
  "author": "acieshk",
  "license": "MIT",
  "types": "src/index.d.ts"
}
